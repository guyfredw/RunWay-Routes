# RunWay Routes prototype: same road rules, no stop penalties
---context:global
assign downhillcost 0
assign downhillcutoff 1.5
assign uphillcost 0
assign uphillcutoff 1.5
assign turnInstructionMode = 1
assign validForFoot 1
assign processUnusedTags = true

---context:way
assign turncost 8
assign initialclassifier = if footway=crossing then 2 else if route=ferry then 1 else 0
assign initialcost = if route=ferry then 100000
                     else if footway=crossing then 0
                     else 0
assign defaultaccess
  switch access=
    ( if motorroad=yes then false
      else if highway=motorway|motorway_link then false
      else true )
    switch or access=private access=no false true
assign footaccess
  switch foot=
    defaultaccess
    not or foot=private or foot=no foot=use_sidepath
assign hassidewalk = sidewalk=both|left|right|yes|separate
assign roadcost =
  if highway=footway|path|pedestrian|cycleway|living_street|track then 1.0
  else if highway=residential|unclassified then 1.1
  else if highway=service then ( if service=parking_aisle|driveway then 6 else 3 )
  else if highway=tertiary|tertiary_link then ( if hassidewalk then 1.15 else 1.6 )
  else if highway=secondary|secondary_link then ( if hassidewalk then 1.3 else 2.5 )
  else if highway=primary|primary_link then ( if hassidewalk then 1.5 else 4 )
  else if highway=trunk|trunk_link then ( if hassidewalk then 2 else 8 )
  else if highway=steps then 3
  else if highway= then 100000
  else if highway=proposed|abandoned|construction then 100000
  else 1.3
assign costfactor = if footaccess then roadcost else 100000
assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign classifiermask = 0
assign priorityclassifier = 4

---context:node
assign defaultaccess
  switch access=
    1
    switch or access=private access=no 0 1
assign footaccess
  switch foot=
    defaultaccess
    switch or foot=private foot=no 0 1
assign stopcost =
  if highway=traffic_signals then 0
  else if crossing=traffic_signals then 0
  else if highway=crossing then 0
  else 0
assign initialcost =
  if not footaccess then 1000000
  else if barrier=gate then 2000
  else stopcost
